{
	"extends": "../jsconfig-base.json",
	"compilerOptions": {
		"module": "esnext",
		// Support ES2022 functions and runtime APIs, but not language features
		"target": "es2022",
		"moduleResolution": "bundler",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["oojs", "oojs-ui", "jquery", "jqueryui", "types-mediawiki"]
	},
	"include": [
		"**/*",
		"../config/**/*",
		"../misc/convenientDiscussions-generateBasicConfig.js",
		"../data/**/*"
	],
	// This has no effect unfortunately - worker files are included due to references from
	// updateChecker.js.
	"exclude": ["worker/**/*"]
}
